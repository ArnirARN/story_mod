          "text": "У меня сердце звезды.",
          "next": "heart_other",
          "if": {
            "not_role": "keeper",
            "items": [
              {
                "item": "storymod:star_core",
                "count": 1
              }
            ],
            "not_flags": [
              "os_star_heart"
            ]
          }
