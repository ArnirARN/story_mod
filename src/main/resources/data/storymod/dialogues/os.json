          ]
        },
        {
          "text": "К храму стражей под водой.",
          "next": "lamp_menu",
          "actions": [
            {
              "type": "give_structure_compass",
              "structure": "storymod:monuments",
              "radius": 64,
              "name": "Компас: храм стражей"
            }
          ]
        },
        {
          "text": "К подземной библиотеке.",
          "next": "lamp_menu",
          "actions": [
            {
              "type": "give_structure_compass",
              "structure": "storymod:strongholds",
              "radius": 100,
              "name": "Компас: подземная библиотека"
            }
          ]
        },
        {
          "text": "К особняку в тёмном лесу.",
          "next": "lamp_menu",
          "actions": [
            {
              "type": "give_structure_compass",
              "structure": "storymod:mansions",
              "radius": 100,
              "name": "Компас: особняк"
            }
          ]
        },
        {
          "text": "Хватит.",
          "next": "hub"
        }
      ]
