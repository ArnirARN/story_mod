          }
        },
        {
          "text": "Челнок пропал.",
          "next": "lost_shuttle",
          "if": {
            "role": "keeper",
            "flags": [
              "loom_ready"
            ],
            "not": {
              "items": [
                {
                  "item": "storymod:loom_shuttle",
                  "count": 1
                }
              ]
