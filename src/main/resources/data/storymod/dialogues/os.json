        {
          "text": "Сердечник Пламени",
          "next": "h_flame",
          "if": {
            "not_flags": [
              "found_core_flame"
            ]
          }
        },
        {
          "text": "Сердечник Приливов",
          "next": "h_tides",
          "if": {
            "not_flags": [
              "found_core_tides"
            ]
          }
        },
        {
          "text": "Сердечник Пустоты",
          "next": "h_void",
          "if": {
            "not_flags": [
              "found_core_void"
            ]
          }
        },
        {
          "text": "Все четыре уже найдены.",
          "next": "h_done",
