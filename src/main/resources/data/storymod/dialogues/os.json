  "nodes": {
    "intro": {
      "text": [
        "Щёлк. Новый голос. Регистрирую.",
        "Я Ось. Автоматон-помощник. Назначение: помогать. Хозяин Вельд велел подсказывать, где искать Сердечники. Ось помнит карты Ордена. Многие карты. Не все."
      ],
      "actions": [
        {
          "type": "set_flag",
          "flag": "os_met"
        }
      ],
      "options": [
        {
          "text": "Где искать Сердечники?",
          "next": "hints"
        },
        {
          "text": "Кто тебя сделал?",
          "next": "maker"
        }
      ]
    },
    "hub": {
      "text": "Ось слушает.",
      "options": [
        {
          "text": "Где искать Сердечники?",
          "next": "hints"
        },
        {
          "text": "Кто тебя сделал?",
          "next": "maker",
          "if": {
            "not_flags": [
              "os_memory"
            ]
          }
        },
        {
          "text": "Ты знаешь, кто такая Пепельная?",
          "next": "mem1",
          "if": {
            "flags": [
              "ash_met_2"
            ],
            "not_flags": [
              "os_memory"
            ]
          }
        },
        {
          "text": "Напомни, где искать письмо.",
          "next": "letter_hint",
          "if": {
            "flags": [
              "os_memory"
            ],
            "not_flags": [
              "page_letter"
            ]
          }
        },
        {
          "text": "Среди записей была твоя схема. Там сказано, что тебя собрал не Вельд.",
          "next": "schema",
          "if": {
            "flags": [
              "page_os_schema"
            ],
            "not_flags": [
              "os_schema",
              "os_memory"
            ]
          }
        },
        {
          "text": "Ничего. До встречи.",
          "next": null
        }
      ]
    },
    "hints": {
      "text": "Ось перечисляет. Какой Сердечник?",
      "options": [
        {
          "text": "Сердечник Глубин",
          "next": "h_depths",
          "if": {
            "not_flags": [
              "found_core_depths"
