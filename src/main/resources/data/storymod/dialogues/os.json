    "lamp2": {
      "text": "Лампа собрана. Ось настраивает. Приходи следующей ночью. Наладчица нужна, чтобы закрутить последний винт.",
      "actions": [
        {
          "type": "sound",
          "sound": "minecraft:block.amethyst_block.chime"
        }
      ],
      "options": [
        {
          "text": "Хорошо.",
          "next": "hub"
        }
      ]
    },
    "lamp_wait": {
      "text": "Лампа гудит. Настройка идёт. Ночью, наладчица. Не раньше, чем пройдёт день.",
      "options": [
        {
          "text": "…",
          "next": "hub"
        }
      ]
    },
    "lamp_done": {
      "text": [
        "Последний винт. Щёлк.",
        "Лампа поёт. Ось слышит дальние места: эхо под землёй, песню под водой, шёпот старых книг. Ось может показать дорогу. Любому из вас."
      ],
      "actions": [
        {
          "type": "set_flag",
          "flag": "os_lamp_ready"
        },
        {
          "type": "sound",
          "sound": "minecraft:block.amethyst_block.resonate"
        }
      ],
      "options": [
        {
          "text": "Покажи.",
          "next": "lamp_menu"
        }
      ]
    },
    "lamp_menu": {
      "text": "Куда?",
      "options": [
        {
          "text": "К спящему городу глубин.",
          "next": "lamp_menu",
          "actions": [
            {
              "type": "give_structure_compass",
              "structure": "storymod:ancient_cities",
              "radius": 96,
              "name": "Компас: спящий город"
