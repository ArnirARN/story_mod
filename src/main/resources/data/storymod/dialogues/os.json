        {
          "text": "Ось, просканируй Нэля.",
          "next": "scan_nel",
          "if": {
            "role": "keeper",
            "flags": [
              "nel_met"
            ],
            "not_flags": [
              "os_scanned_nel",
              "nel_cured",
              "nel_gone",
              "nel_lost"
            ]
          }
        },
        {
          "text": "Ось, чем сшивали небо?",
          "next": "loom1",
          "if": {
            "role": "keeper",
            "flags": [
              "seam_2"
            ],
            "not_flags": [
              "loom_started"
            ]
          }
        },
        {
          "text": "Ось, небо можно сшить?",
          "next": "loom_other",
          "if": {
            "not_role": "keeper",
            "flags": [
              "seam_2"
            ],
            "not_flags": [
              "loom_started"
            ]
          }
        },
        {
          "text": "Как станок?",
          "next": "loom_wait",
          "if": {
            "flags": [
              "loom_started"
            ],
            "not_flags": [
              "loom_ready"
            ]
          }
        },
        {
          "text": "У меня сердце звезды.",
          "next": "heart1",
          "if": {
            "role": "keeper",
            "items": [
              {
                "item": "storymod:star_core",
                "count": 1
              }
