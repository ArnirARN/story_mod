            "flags": [
              "vote1_proposed"
            ],
            "not_flags": [
              "window_open",
              "window_closed",
              "window_split",
              "v1_w_open",
              "v1_w_close"
            ]
          },
          "actions": [
            {
              "type": "set_flag",
              "flag": "v1_w_close"
            }
