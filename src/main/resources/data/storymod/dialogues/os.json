          "text": "Шов открыт. Что делать?",
          "next": "rift_info",
          "if": {
            "flags": [
              "rift_open"
            ]
          }
        },
        {
          "text": "Окуляр пропал.",
          "next": "lost_eyepiece",
          "if": {
            "flags": [
              "nel_q1_done"
            ],
            "not": {
              "items": [
                {
                  "item": "storymod:star_eyepiece",
                  "count": 1
                }
              ]
